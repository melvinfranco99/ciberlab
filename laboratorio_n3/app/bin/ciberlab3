#!/usr/bin/env bash
# CiberLab N3 — lanzador (nivel avanzado)
#   ciberlab3 [vista]         abre una vista (inicio redteam tecnicas appsec ad dfir malware cloud lab auditorias glosario comandos)
#   ciberlab3 --server         solo arranca el servidor
#   ciberlab3 --stop           detiene el servidor
#   ciberlab3 --escritorios    abre cada programa en su escritorio (1-8, bspwm o EWMH)
set -u
SELF_DIR="$(dirname "$(readlink -f "$0")")"
APP_DIR="$(readlink -f "$SELF_DIR/..")"
PORT="${CIBERLAB3_PORT:-8768}"
URL="http://127.0.0.1:$PORT"
LOG="${XDG_RUNTIME_DIR:-/tmp}/ciberlab3-server.log"
PROFILE="${XDG_CONFIG_HOME:-$HOME/.config}/ciberlab3-browser"
LAYOUT="${CIBERLAB3_LAYOUT:-1:inicio 2:redteam 3:appsec 4:ad 5:dfir 6:malware 7:cloud 8:lab 8:auditorias}"

up() { curl -fs -m 2 "$URL/api/health" >/dev/null 2>&1; }

start_server() {
    up && return 0
    ( cd "$APP_DIR" && setsid -f python3 -m ciberlab3 >"$LOG" 2>&1 )
    for _ in $(seq 1 50); do up && return 0; sleep 0.2; done
    notify-send -a "CiberLab N3" "CiberLab N3" "No se pudo iniciar el servidor. Revisa $LOG" 2>/dev/null
    return 1
}

browser() {
    for b in brave brave-browser chromium google-chrome-stable microsoft-edge-stable vivaldi-stable; do
        command -v "$b" >/dev/null 2>&1 && { echo "$b"; return; }
    done
}

open_view() {
    local b; b=$(browser)
    if [ -n "$b" ]; then
        setsid -f "$b" --app="$1" --user-data-dir="$PROFILE" --class=CiberLab3 \
            --no-first-run --no-default-browser-check --password-store=basic --start-maximized >/dev/null 2>&1
    else xdg-open "$1"; fi
}

wins() {
    local w
    for w in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -o '0x[0-9a-f]*'); do
        xprop -id "$w" WM_CLASS 2>/dev/null | grep -qi '"ciberlab3"' && printf '%d\n' "$w"
    done | sort
}

desktops() {
    local first=1 item n view before new WM
    if command -v bspc >/dev/null && bspc query -D >/dev/null 2>&1; then WM=bspwm
    elif command -v xdotool >/dev/null; then WM=ewmh; else WM=none; fi
    for item in $LAYOUT; do
        n=${item%%:*}; view=${item#*:}
        before=$(wins)
        [ "$WM" = bspwm ] && bspc rule -a CiberLab3 -o desktop="^$n" follow=off
        open_view "$URL/#/$view"
        [ "$WM" = none ] && continue
        new=""
        for _ in $(seq 1 60); do
            new=$(comm -13 <(echo "$before") <(wins) | head -1)
            [ -n "$new" ] && break; sleep 0.2
        done
        if [ -n "$new" ] && [ "$WM" = ewmh ]; then xdotool set_desktop_for_window "$new" $((n - 1)) 2>/dev/null
        elif [ -z "$new" ] && [ "$WM" = bspwm ]; then bspc rule -r CiberLab3 2>/dev/null; fi
        [ $first = 1 ] && { first=0; sleep 1; }
    done
    if [ "$WM" = bspwm ]; then bspc desktop -f "^1"; elif [ "$WM" = ewmh ]; then xdotool set_desktop 0; fi
}

case "${1:-}" in
    --server) start_server; exit $? ;;
    --stop) pkill -f "python3 -m ciberlab3$"; exit 0 ;;
    --escritorios) start_server || exit 1; desktops; exit 0 ;;
esac
start_server || exit 1
open_view "$URL/#/${1:-inicio}"
