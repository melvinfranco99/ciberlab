#!/usr/bin/env bash
# CiberLab — lanzador
#   ciberlab [vista]          abre una vista (inicio ofensiva web vulns defensa redes cloud lab auditorias)
#   ciberlab --server         solo arranca el servidor
#   ciberlab --stop           detiene el servidor
#   ciberlab --escritorios    abre cada programa en su escritorio (1-8, bspwm o EWMH)
set -u
SELF_DIR="$(dirname "$(readlink -f "$0")")"
APP_DIR="$(readlink -f "$SELF_DIR/..")"
PORT="${CIBERLAB_PORT:-8766}"
URL="http://127.0.0.1:$PORT"
LOG="${XDG_RUNTIME_DIR:-/tmp}/ciberlab-server.log"
PROFILE="${XDG_CONFIG_HOME:-$HOME/.config}/ciberlab-browser"
LAYOUT="${CIBERLAB_LAYOUT:-1:inicio 2:ofensiva 3:web 4:vulns 5:defensa 6:redes 7:cloud 8:lab 8:auditorias}"

up() { curl -fs -m 2 "$URL/api/health" >/dev/null 2>&1; }

start_server() {
    up && return 0
    ( cd "$APP_DIR" && setsid -f python3 -m ciberlab >"$LOG" 2>&1 )
    for _ in $(seq 1 50); do up && return 0; sleep 0.2; done
    notify-send -a CiberLab "CiberLab" "No se pudo iniciar el servidor. Revisa $LOG" 2>/dev/null
    return 1
}

browser() {
    for b in brave brave-browser chromium google-chrome-stable microsoft-edge-stable vivaldi-stable; do
        command -v "$b" >/dev/null 2>&1 && { echo "$b"; return; }
    done
}

open_view() {
    local b; b=$(browser)
    if [ -n "$b" ]; then
        setsid -f "$b" --app="$1" --user-data-dir="$PROFILE" --class=CiberLab \
            --no-first-run --no-default-browser-check --password-store=basic --start-maximized >/dev/null 2>&1
    else xdg-open "$1"; fi
}

wins() {
    local w
    for w in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | grep -o '0x[0-9a-f]*'); do
        xprop -id "$w" WM_CLASS 2>/dev/null | grep -qi '"ciberlab"' && printf '%d\n' "$w"
    done | sort
}

desktops() {
    local first=1 item n view before new WM
    if command -v bspc >/dev/null && bspc query -D >/dev/null 2>&1; then WM=bspwm
    elif command -v xdotool >/dev/null; then WM=ewmh; else WM=none; fi
    for item in $LAYOUT; do
        n=${item%%:*}; view=${item#*:}
        before=$(wins)
        [ "$WM" = bspwm ] && bspc rule -a CiberLab -o desktop="^$n" follow=off
        open_view "$URL/#/$view"
        [ "$WM" = none ] && continue
        new=""
        for _ in $(seq 1 60); do
            new=$(comm -13 <(echo "$before") <(wins) | head -1)
            [ -n "$new" ] && break; sleep 0.2
        done
        if [ -n "$new" ] && [ "$WM" = ewmh ]; then xdotool set_desktop_for_window "$new" $((n - 1)) 2>/dev/null
        elif [ -z "$new" ] && [ "$WM" = bspwm ]; then bspc rule -r CiberLab 2>/dev/null; fi
        [ $first = 1 ] && { first=0; sleep 1; }
    done
    if [ "$WM" = bspwm ]; then bspc desktop -f "^1"; elif [ "$WM" = ewmh ]; then xdotool set_desktop 0; fi
}

case "${1:-}" in
    --server) start_server; exit $? ;;
    --stop) pkill -f "python3 -m ciberlab$"; exit 0 ;;
    --escritorios) start_server || exit 1; desktops; exit 0 ;;
esac
start_server || exit 1
open_view "$URL/#/${1:-inicio}"
